# Salin ke .env lalu sesuaikan. Server membaca berkas ini saat mulai.
PORT=3000

# Penyedia model: "mock" (berbasis aturan, tanpa internet, untuk demo dan uji)
# atau "anthropic" (butuh `npm install` dan ANTHROPIC_API_KEY).
LLM_PROVIDER=mock
# Nama model hanya ditulis di sini, tidak di kode (PRD 9.5).
LLM_MODEL=claude-opus-5-5
# Cadangan bila penyedia utama gagal.
LLM_FALLBACK_PROVIDER=mock
ANTHROPIC_API_KEY=

# Lokasi basis data SQLite.
DB_PATH=data/kajar.db

# Set "1" di produksi (HTTPS) agar cookie bertanda Secure dan HSTS aktif.
COOKIE_SECURE=0

# "1" menampilkan panel masuk cepat untuk juri dan pengunjung demo. Matikan untuk pilot sungguhan.
DEMO_MODE=0
