{
  "name": "kajar",
  "version": "0.1.0",
  "private": true,
  "description": "KAJAR (Kawan Belajar): tutor AI berbasis chat, hemat data, dengan peninjauan mahasiswa.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.js\"",
    "eval": "node --disable-warning=ExperimentalWarning eval/run.js",
    "budget": "node --disable-warning=ExperimentalWarning eval/budget.js"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "*"
  }
}
